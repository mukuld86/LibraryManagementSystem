@model LibraryManagementSystem.DataAccess.Models.Member

@{
    ViewData["Title"] = "Delete Member";
}

<div class="container mt-4">

    <h2>Delete Member</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this member?
    </div>

    <div class="card mb-3">

        <div class="card-body">

            <p>
                <strong>Member ID:</strong>
                @Model.MemberId
            </p>

            <p>
                <strong>Name:</strong>
                @Model.MemberName
            </p>

            <p>
                <strong>Email:</strong>
                @Model.Email
            </p>

            <p>
                <strong>Phone:</strong>
                @Model.PhoneNumber
            </p>

        </div>

    </div>

    <form asp-action="DeleteConfirmed"
          method="post">

        <input type="hidden"
               name="memberId"
               value="@Model.MemberId" />

        <button type="submit"
                class="btn btn-danger">
            Yes, Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>