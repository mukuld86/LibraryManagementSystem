@model List<LibraryManagementSystem.DataAccess.Models.Member>

@{
    ViewData["Title"] = "Members";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Members</h2>

        <a asp-action="Add"
           class="btn btn-primary">
            Add Member
        </a>

    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No members found.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Member ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var member in Model)
                {
                    <tr>

                        <td>
                            @member.MemberId
                        </td>

                        <td>
                            @member.MemberName
                        </td>

                        <td>
                            @member.Email
                        </td>

                        <td>
                            @member.PhoneNumber
                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@member.MemberId"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@member.MemberId"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>